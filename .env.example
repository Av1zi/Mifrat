# Local-only overrides — copy to .env and fill in real values.
# Nothing here is ever committed (.env is gitignored). This project needs
# zero secrets for cloud runs (GITHUB_TOKEN only); only local-only tools
# (Nano SSH key paths, local debug flags) belong here if ever needed.
# Example:
# MIFRAT_DEBUG=0

# Verified AI extraction (python -m scraper.extract). Free Gemini tier:
# MIFRAT_EXTRACT_BACKEND=gemini
# GOOGLE_KEY=your-key-here
# or Claude: ANTHROPIC_API_KEY=your-key-here
# The free tier's quota differs per model. If gemini-3.5-flash stops early with a
# per-day 429, try another model without changing code:
# MIFRAT_EXTRACT_MODEL=gemini-3.1-flash-lite
#
# Several providers at once (tried in order; one that hits a per-day quota is
# skipped for the rest of the run). Each model is audited on its own.
# MIFRAT_EXTRACT_BACKEND=gemini,groq,intern
# GOOGLE_KEY=...
# GROQ_KEY=...
# MIFRAT_EXTRACT_MODEL_GROQ=openai/gpt-oss-20b      # any model id your key lists
# INTERN_KEY=...
# INTERN_BASE_URL=https://.../v1                     # from the provider's docs (OpenAI-compatible)
# MIFRAT_EXTRACT_MODEL_INTERN=...                    # required: no default

# Reasoning models can take minutes per answer. Raise the timeout (seconds) or turn
# thinking down with extra request fields (JSON, per provider; see the provider's docs):
# MIFRAT_EXTRACT_TIMEOUT=300
# MIFRAT_EXTRACT_EXTRA_INTERN={"thinking_mode": false}
# MIFRAT_EXTRACT_EXTRA_GROQ={"reasoning_effort": "low"}

{
  "name": "mifrat-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-data.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "lint": "node tools/lint/run.mjs",
    "format": "prettier --write",
    "format:check": "prettier --check test vitest.config.ts tools",
    "smoke": "python scripts/screenshots.py --smoke"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-hebrew": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.129.0"
  }
}

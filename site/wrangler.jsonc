{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Matches the Worker name already created (mifrat.avizi.workers.dev)
	// — keep this the same so deploys update it in place.
	// Once a custom domain serves the site, set "workers_dev": false and
	// "preview_urls": false (today workers.dev is the only hostname).
	"name": "mifrat",
	"compatibility_date": "2026-08-25",
	// Worker entrypoint: short build-link API + /list/* SPA fallback.
	// Static assets still serve directly; only these routes invoke the Worker.
	"main": "./worker.ts",
	"observability": {
		"enabled": true
	},
	"assets": {
		// The BUILT output, not the source folder. Root directory in the
		// Workers Builds dashboard is set to "site", so this resolves to
		// site/dist — only exists after `npm run build` actually runs.
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/list/*",
			// Scrape console: the Worker checks ADMIN_PASSWORD before serving it.
			"/admin",
			"/admin/*"
		]
	},
	// Ops alert cron (ops-worker.ts): every 30 minutes it checks the scrape
	// report, the deployed site and the Nano run events, pushes alerts to
	// ntfy, and on the first tick of 10:xx Israel time (07:00 or 08:00 UTC,
	// DST-aware in code) sends the daily scrape report. Free plan: 5 cron
	// triggers per account; this uses one.
	"triggers": {
		"crons": ["*/30 * * * *"]
	},
	// D1 table `lists` (site/migrations/0001_lists.sql): short-id -> build
	// mapping. Create it with `wrangler d1 create mifrat-lists` and apply the
	// migration (see site/README.md, "Build sharing"). The ops alert tables
	// (migrations/0002_ops.sql) live in the same database.
	//
	// Ops secrets (set in the dashboard or `wrangler secret put`, NEVER here):
	// NTFY_TOPIC_URL, NTFY_TOKEN, OPS_INGEST_TOKEN, HEALTHCHECK_URL, ADMIN_PASSWORD.
	"d1_databases": [
		{
			"binding": "LISTS_DB",
			"database_name": "mifrat-lists",
			"database_id": "883187e2-7208-44a1-9aec-e9866e2cc4c9"
		}
	],
	// POST /api/lists limiter, keyed per IPv4 address / IPv6 /64 (worker.ts).
	// Approximate and per Cloudflare location; the Worker falls back to its
	// in-memory limiter if the binding is missing or fails. namespace_id
	// must be unique in the account; period must be 10 or 60.
	"ratelimits": [
		{
			"name": "LISTS_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	]
}
[Unit]
Description=Nightly timer for the KSP detail scrape (PC Part Picker IL)

[Timer]
# Night window (21:00-04:00 UTC = 23:00-07:00 Israel), when KSP sees the
# least traffic. After the KSP listing run (00:55-01:55 start, done by 02:35
# UTC) with a gap, because KSP rate-limits per IP over a window: starts
# 03:00-03:30 UTC, ~15 minutes for 150 items, done before 04:00 UTC.
# run_ksp_detail.sh skips the night when the listing run did not succeed.
OnCalendar=*-*-* 03:00:00 UTC
RandomizedDelaySec=1800

[Install]
WantedBy=timers.target

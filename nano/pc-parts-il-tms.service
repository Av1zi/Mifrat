[Unit]
Description=Scrape TMS for the PC Part Picker (IL) pipeline
After=network-online.target
Wants=network-online.target
# Phone alerts (nano/ops_notify.sh): a failed run reports itself here, a
# successful one through ExecStartPost below (OnSuccess= needs systemd 249).
OnFailure=pc-parts-il-notify@%n.service

[Service]
Type=oneshot
User=avizi
WorkingDirectory=/home/avizi/pc-parts-il
ExecStart=/home/avizi/pc-parts-il/nano/run_tms.sh
# '-': a notify failure never fails the scrape.
ExecStartPost=-/home/avizi/pc-parts-il/nano/ops_notify.sh %n success
StandardOutput=journal
StandardError=journal
# Give the spider up to 30 minutes before killing it.
TimeoutStartSec=1800

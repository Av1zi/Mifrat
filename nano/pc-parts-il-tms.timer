[Unit]
Description=Daily timer for the TMS scraper (PC Part Picker IL)

[Timer]
# Night window: every scheduled run stays inside 23:00-07:00 Israel time in
# BOTH seasons (UTC+2 winter / UTC+3 summer), i.e. 21:00-04:00 UTC.
# TMS goes first: 21:15 UTC + up to 90 min of jitter (starts 21:15-22:45 UTC,
# finishes by 23:15 UTC under the 30 min service timeout).
OnCalendar=*-*-* 21:15:00 UTC
RandomizedDelaySec=5400
# No Persistent=: a catch-up run after downtime would land in daytime, outside
# the night window. The morning-after fallback timer and the normalizer's
# 14-day stale-forward cover a missed night.

[Install]
WantedBy=timers.target

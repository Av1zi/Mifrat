[Unit]
Description=Daily timer for the 1PC scraper (PC Part Picker IL)

[Timer]
# Night window (21:00-04:00 UTC = 23:00-07:00 Israel in both seasons).
# Sequentially behind TMS on the same IP: TMS finishes by 23:15 UTC, 1PC
# starts 23:20-00:20 UTC and finishes by 00:50 UTC.
OnCalendar=*-*-* 23:20:00 UTC
RandomizedDelaySec=3600
# No Persistent=: see pc-parts-il-tms.timer.

[Install]
WantedBy=timers.target

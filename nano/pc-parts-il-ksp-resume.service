[Unit]
Description=One KSP recovery attempt after the three-day pause
After=network-online.target
Wants=network-online.target
OnFailure=pc-parts-il-notify@%n.service

[Service]
Type=oneshot
User=avizi
WorkingDirectory=/home/avizi/pc-parts-il
ExecStart=/bin/bash /home/avizi/pc-parts-il/nano/run_ksp_resume.sh
# Only a successful recovery enables the daily listing timer. '+' executes
# this systemctl action as root; crawler itself remains low-privilege avizi.
ExecStartPost=+/bin/systemctl enable --now pc-parts-il-ksp.timer
ExecStartPost=-/home/avizi/pc-parts-il/nano/ops_notify.sh %n success
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3600

[Unit]
Description=Verified AI spec extraction for the PC Part Picker (IL) pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=avizi
WorkingDirectory=/home/avizi/pc-parts-il
ExecStart=/home/avizi/pc-parts-il/nano/run_extract.sh
StandardOutput=journal
StandardError=journal
# The free tier is slow (one request every ~7 s); a stopped run continues tomorrow.
TimeoutStartSec=5400

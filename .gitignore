__pycache__/
*.pyc
.venv/
venv/
node_modules/

# Secrets / credentials — never commit real values. See .env.example for
# the variable names this project expects; copy it to .env locally and
# fill in real values there (which stays ignored).
.env
.env.*
!.env.example
*.pem
*.key
# Wrangler local state (login session, dev D1/sqlite, deploy cache) and
# local-only secret overrides — never commit. Safe to commit: wrangler.jsonc
# (worker name, D1 database_id/name and binding names are public resource
# IDENTIFIERS, useless without your Cloudflare API token, which lives only
# in `wrangler login`'s OS-keychain session and must never be pasted anywhere).
.wrangler/
.dev.vars
.dev.vars.*

*.egg-info/
build/
dist/

decisions.md
pc-parts-il-plan.md
AGENTS.md

# Local test artifacts (e.g. `scrapy crawl tms -o tms_test.jsonl` while
# developing) — not meant for version control, and may contain a full local
# snapshot of scraped data that has no reason to be duplicated into git
# history on every test run.
*_test.jsonl
*_test.json
scrapy.log
*.log
tmp/

# data/raw/**/*.jsonl and data/catalog.json ARE meant to be committed.

# docyx/pc-part-dataset mirror + index.
# Treated as regenerable, not source data: normalize-and-deploy.yml runs
# `python -m scraper.pcpartdb refresh` before each normalize run, so this
# is always rebuilt fresh from GitHub's raw CDN (~7MB, a few seconds).
# Committing it was a one-time mistake that added 16MB to history for a
# feature that wasn't even wired in yet — don't recommit it. If you ever
# need it locally: `python -m scraper.pcpartdb refresh`.
data/pcpartdb/

# List thumbnails are derived at site build time (site/scripts/copy-data.mjs),
# never committed. Covers themselves are data/images/<vendor>/<sku>.webp.
data/images/*/thumbs/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/


# Copied from ../data/site + referenced ../data/images by scripts/copy-data.mjs
# on every dev/build run — regenerated, not a source file.
# (Site-level .gitignore covers these; kept here as a backstop.)
site/public/data/
site/public/images/
tsconfig.tsbuildinfo

# Manufacturer-page raw HTML cache (scraper/mfr); only data/mfr/<brand>.json is committed.
data/mfr/.cache/

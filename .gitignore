__pycache__/
*.pyc
.venv/
venv/
node_modules/

# Secrets / credentials — never commit real values. See .env.example for
# the variable names this project expects; copy it to .env locally and
# fill in real values there (which stays ignored).
.env
.env.*
!.env.example
*.pem
*.key

*.egg-info/
build/
dist/

# decisions.md is a local-only running log, deliberately not pushed to the
# public repo (see the note in README's status section). pc-parts-il-plan.md
# stays TRACKED (it already was before this line existed) — this entry only
# stops it from being re-added if it's ever untracked on purpose; that's a
# separate decision to make explicitly, not a side effect of this line.
decisions.md

# Local test artifacts (e.g. `scrapy crawl tms -o tms_test.jsonl` while
# developing) — not meant for version control, and may contain a full local
# snapshot of scraped data that has no reason to be duplicated into git
# history on every test run.
*_test.jsonl
*_test.json
scrapy.log
*.log
tmp/

# data/raw/**/*.jsonl and data/catalog.json ARE meant to be committed — see
# §5 of the plan. Nothing to ignore under data/ anymore now that the old
# Scrapy-Cloud intermediate file (data/listings_latest.jsonl) is gone.

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
